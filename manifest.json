{
  "manifest_version": 3,
  "name": "BandLab Tools",
  "version": "1.0.6",
  "description": "A powerful toolset for BandLab with bypass features and enhancements",
  "release_notes": "Added 'Play All Songs' feature, improved themes, and fixed various bugs.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["*://*.bandlab.com/*"],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pagePatch.js",
        "tools/cleanInviteLinks.js",
        "tools/blockAnalytics.js",
        "tools/sony360Audio.js",
        "tools/membershipBypass.js",
        "tools/harmonyEditorUnlock.js",
        "tools/fullExperimentals.js",
        "tools/totalProjects.js",
        "tools/playAllSongs.js",
        "popup.html",
        "popup.css",
        "popup.js",
        "updateChecker.js",
        "icon128.png",
        "icon48.png",
        "icon16.png"
      ],
      "matches": ["*://*.bandlab.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.bandlab.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.bandlab.com/*"],
      "js": ["pagePatch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.bandlab.com/*"],
      "js": [
        "tools/cleanInviteLinks.js",
        "tools/blockAnalytics.js",
        "tools/sony360Audio.js",
        "tools/membershipBypass.js",
        "tools/harmonyEditorUnlock.js",
        "tools/fullExperimentals.js",
        "tools/totalProjects.js",
        "tools/playAllSongs.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ]
}
